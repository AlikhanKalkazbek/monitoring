      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service_name=\"$service\", span_name=~\"${operation:pipe}\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "queryType": "range",
          "refId": "A"
        }
