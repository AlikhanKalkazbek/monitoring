          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service_name=\"$service\", span_name=~\"${operation:pipe}\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "Invocations"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (span_name) (increase(traces_spanmetrics_calls_total{service_name=\"$service\", span_name=~\"${operation:pipe}\", status_code=\"STATUS_CODE_ERROR\"}[$__range]))",
          "format": "table",
