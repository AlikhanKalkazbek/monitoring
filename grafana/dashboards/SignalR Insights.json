      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service_name=\"$service\", span_name=~\"${operation:pipe}\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "p95 Latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Invocations per second per hub method.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
