        "multi": false,
        "name": "service",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(traces_spanmetrics_calls_total, service_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allowCustomValue": false,
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(traces_spanmetrics_calls_total{service_name=\"$service\"}, span_kind)",
        "description": "Span kind: SERVER=inbound, INTERNAL=in-process, CLIENT=outbound.",
        "includeAll": true,
        "label": "Kind",
        "multi": true,
        "name": "kind",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(traces_spanmetrics_calls_total{service_name=\"$service\"}, span_kind)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
